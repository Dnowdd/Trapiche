# Database (Neon Postgres)
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" to skip email verification on sign-up (local dev)
SKIP_EMAIL_VERIFICATION="false"

# Resend (transactional email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Trapiche <onboarding@resend.dev>"

# Google Books API
GOOGLE_BOOKS_API_KEY=""

# Google sign-in (optional): the button only shows when both are set
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (optional): enables Prático, the reading assistant
OPENAI_API_KEY=""
# Defaults to gpt-6-luna
OPENAI_MODEL=""
# low (default), minimal, medium, high, or off for models without reasoning
OPENAI_REASONING_EFFORT=""

# Daily maintenance job (Vercel Cron sends it as a Bearer token)
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Upstash Redis (optional): shared rate limits across serverless instances.
# Without it, limits are kept in memory per instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
